# WeDrip application URL
NEXT_PUBLIC_APP_URL=http://localhost:5174

# Google OAuth
# Create these credentials in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5174/api/auth/callback/google
AUTH_SESSION_SECRET=replace-with-a-long-random-secret

# Planned Shopify commerce integration
# Shopify remains the production system of record for products, customers,
# inventory, carts, checkout, orders, payments, shipping, and taxes.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-shopify-storefront-access-token

# Optional Cloudflare D1 binding name for future persistence.
D1_BINDING_NAME=DB

# Supabase public database access
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
